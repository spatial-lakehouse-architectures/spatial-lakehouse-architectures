<svg class="logo-mark" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Spatial Lakehouse Architectures logo">
  <defs>
    <linearGradient id="lg-water" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#3fb8c4"/>
      <stop offset="100%" stop-color="#0e6e7d"/>
    </linearGradient>
    <linearGradient id="lg-land" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7ec48b"/>
      <stop offset="100%" stop-color="#3f8c5e"/>
    </linearGradient>
    <linearGradient id="lg-sun" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f1c560"/>
      <stop offset="100%" stop-color="#c87a1f"/>
    </linearGradient>
  </defs>
  <!-- bottom plane: storage hex -->
  <polygon points="32,54 12,44 12,28 32,38 52,28 52,44" fill="url(#lg-water)" opacity="0.95"/>
  <!-- middle plane: catalog hex -->
  <polygon points="32,40 14,30 14,18 32,28 50,18 50,30" fill="url(#lg-land)" opacity="0.95"/>
  <!-- top plane: compute hex -->
  <polygon points="32,26 18,18 18,10 32,18 46,10 46,18" fill="url(#lg-sun)" opacity="0.95"/>
  <!-- grid lines -->
  <g stroke="#ffffff" stroke-opacity="0.55" stroke-width="0.8" fill="none">
    <line x1="22" y1="48" x2="42" y2="48"/>
    <line x1="22" y1="34" x2="42" y2="34"/>
    <line x1="26" y1="22" x2="38" y2="22"/>
  </g>
</svg>
