{% from "partials/icons.njk" import icon %}
<footer class="site-footer" role="contentinfo">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      {% include "partials/logo.njk" %}
      <div>
        <p class="site-footer__name">{{ site.name }}</p>
        <p class="site-footer__desc">{{ site.description }}</p>
      </div>
    </div>
    <nav class="site-footer__nav" aria-label="Footer">
      {% for section in site.sections %}
        {% set topics = collections.content | topicsOf(section.slug) %}
        <section class="site-footer__col">
          <h2 class="site-footer__heading" data-section="{{ section.slug }}">
            <a href="{{ site.url }}/{{ section.slug }}/">{{ icon(section.icon) }} {{ section.title }}</a>
          </h2>
          <ul>
            {% for item in topics %}
              <li><a href="{{ site.url }}{{ item.url }}">{{ item.data.title }}</a></li>
            {% endfor %}
          </ul>
        </section>
      {% endfor %}
    </nav>
    <div class="site-footer__bottom">
      <p class="site-footer__legal">© {{ site.name }}. Built for {{ site.audience | lower }}</p>
      <a class="site-footer__social" href="https://github.com/spatial-lakehouse-architectures" aria-label="{{ site.name }} on GitHub" rel="noopener">
        {{ icon("github") }}<span>GitHub</span>
      </a>
    </div>
  </div>
</footer>
