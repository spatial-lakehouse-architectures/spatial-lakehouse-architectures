{% from "partials/icons.njk" import icon %}
<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <a href="{{ site.url }}/" class="site-header__brand" aria-label="{{ site.name }} home">
      {% include "partials/logo.njk" %}
      <span class="site-header__title">
        <span class="site-header__title-main">Spatial Lakehouse</span>
        <span class="site-header__title-sub">Architectures</span>
      </span>
    </a>

    <nav id="primary-nav" class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        <li>
          <a class="site-nav__link {% if page.url == '/' %}is-active{% endif %}" href="{{ site.url }}/">
            {{ icon("home") }}<span>Home</span>
          </a>
        </li>
        {% for section in site.sections %}
          <li>
            <a class="site-nav__link {% if sectionSlug == section.slug %}is-active{% endif %}" href="{{ site.url }}/{{ section.slug }}/" data-section="{{ section.slug }}">
              {{ icon(section.icon) }}<span>{{ section.title | replace(' & ', ' & ') }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button type="button" class="theme-toggle" aria-label="Switch to dark theme" aria-pressed="false">
        <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.9 1.9M16.8 16.8l1.9 1.9M18.7 5.3l-1.9 1.9M7.2 16.8l-1.9 1.9" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
        <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.4A8.4 8.4 0 0 1 9.6 4a8.4 8.4 0 1 0 10.4 10.4Z" fill="currentColor"/></svg>
      </button>

      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">
        {{ icon("menu") }}
        {{ icon("close") }}
      </button>
    </div>
  </div>
</header>
